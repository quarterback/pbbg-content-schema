{
  "name": "pbbg-content-schema",
  "version": "0.6.0",
  "mcpName": "io.github.quarterback/pbbg-content-schema",
  "description": "Schemas, content policies, an agent skill and a local MCP server for interface and narrative architecture in browser games",
  "type": "module",
  "license": "EPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quarterback/pbbg-content-schema.git"
  },
  "homepage": "https://github.com/quarterback/pbbg-content-schema#readme",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "agent-skill",
    "browser-game",
    "pbbg",
    "json-schema",
    "content-design"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.js",
    "./schemas/*": "./schemas/*",
    "./policies/*": "./policies/*",
    "./mcp": "./src/mcp.js"
  },
  "bin": {
    "pbbg-content": "./bin/pbbg-content.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node bin/pbbg-content.js check examples/station.json",
    "pack:check": "npm pack --dry-run"
  },
  "files": [
    "schemas/",
    "policies/",
    "src/",
    "bin/",
    "examples/",
    "skills/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AGENTS.md",
    "NOTICE",
    "server.json"
  ],
  "dependencies": {
    "ajv": "^8.17.1"
  }
}
